# ==============================================================================
# Mobile Store - Supabase & App Configuration
# احصل على هذه القيم من Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# 1. Project URL (مثال: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 2. Public Anon Key (المفتاح العام)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Service Role Secret Key (المفتاح السري للسيرفر لتجاوز RLS في لوحة الأدمن)
SUPABASE_SERVICE_ROLE_KEY=

# 4. Storage Bucket Name (اسم مجلد الصور في Supabase Storage)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=mobiles

# ==============================================================================
# Admin Dashboard Credentials (افتراضي: admin / admin)
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ==============================================================================
# Contact & WhatsApp Settings
# ==============================================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=201065712366
NEXT_PUBLIC_STORE_NAME="موبايل ستور | Mobile Store"
