# ==============================================================================
# Mobile Store - Neon Postgres & App Configuration
# ==============================================================================

# 1. Neon Postgres Connection Strings (managed via `neon deploy` / `neon env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 2. Cloudflare R2 Storage (لتخزين صور المنتجات على Cloudflare)
# اسم الـ Bucket الافتراضي هو mobile-store-images
R2_BUCKET_NAME=mobile-store-images
# اختياري: إذا قمت بتفعيل Public Access أو ربط Custom Domain للـ Bucket في Cloudflare
# مثال: NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev أو https://images.yourstore.com
NEXT_PUBLIC_R2_PUBLIC_URL=

# ==============================================================================
# Admin Dashboard Credentials (افتراضي: admin / admin)
# ==============================================================================
ADMIN_USERNAME=
ADMIN_PASSWORD=
