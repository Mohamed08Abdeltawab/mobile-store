# ==============================================================================
# Mobile Store - Supabase & App Configuration
# احصل على هذه القيم من Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# 1. Project URL (مثال: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 2. Public Anon Key (المفتاح العام)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Service Role Secret Key (المفتاح السري للسيرفر لتجاوز RLS في لوحة الأدمن)
SUPABASE_SERVICE_ROLE_KEY=

# 4. Cloudflare R2 Storage (لتخزين صور المنتجات على Cloudflare)
# اسم الـ Bucket الافتراضي هو mobile-store-images
R2_BUCKET_NAME=mobile-store-images
# اختياري: إذا قمت بتفعيل Public Access أو ربط Custom Domain للـ Bucket في Cloudflare
# مثال: NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev أو https://images.yourstore.com
NEXT_PUBLIC_R2_PUBLIC_URL=

# (قديم/احتياطي) Storage Bucket Name في Supabase Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=mobiles

# ==============================================================================
# Admin Dashboard Credentials (افتراضي: admin / admin)
# ==============================================================================
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ==============================================================================
# Contact & WhatsApp Settings
# ==============================================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=201131350988
NEXT_PUBLIC_STORE_NAME="موبايل ستور | Mobile Store"
